# The environment `docker-compose.production.yml` reads. Copy to `.env` BESIDE the compose file on the
# droplet, fill it in, and `chmod 600` it. Never commit the filled-in copy.
#
# Every value below is a placeholder. `pnpm secrets` refuses a committed file holding a real credential,
# and `scripts/check-deploy-preconditions.mjs` refuses a committed spec holding a secret literal — this
# file passes both because nothing here is real, and it must stay that way.
#
# Generate each secret on the droplet, not here and not in a chat window:
#   openssl rand -hex 32
#
# A value pasted into a conversation is in that conversation's history for good. Rotate anything that has
# been.

# --- the database ------------------------------------------------------------------------------------
#
# The DIRECT cluster credential, never a connection-pool one. ADR 0004 is about PgBouncer transaction
# pooling and `prepare: false`; a MIGRATION may not run through a pool at all, because `db:deploy` holds
# an advisory lock across statements and a transaction pooler can hand those statements to different
# backends. If you add a pool later, it goes on `web` and `worker` and never on `migrate`.
#
# The line below is the ON-BOX form, and it is written without a password on purpose: `pnpm secrets`
# refuses a committed file holding a database URL with a password for any non-loopback host, and it is
# right to — an example that looks like a credential is how a real one gets committed next to it.
#
# For a MANAGED cluster, replace it with the URI the DigitalOcean console shows for the `berelax` database
# (user `doadmin`, port 25060, and keep the `sslmode=require` it comes with). Copy that URI straight into
# this file on the droplet; it never belongs in the repository, in a commit or in a chat window.
DATABASE_URL=postgres://berelax@127.0.0.1:5432/berelax

# --- the origin -------------------------------------------------------------------------------------
#
# The canonical origin this application serves, with no trailing slash. It is NOT cosmetic: canonical
# URLs, sitemap entries, signed document links and the `SITE_ORIGIN_FALLBACK` guard all come from it, and
# a wrong value publishes wrong canonicals that a crawler then keeps.
#
# NOT https://berelaxmassage.com. That domain is served by the spa-management platform, so the CRM needs
# an origin of its own — a subdomain with its own DNS record and its own certificate. RUNBOOK §3.
SITE_ORIGIN=https://REPLACE_SUBDOMAIN.berelaxmassage.com

# --- secrets ----------------------------------------------------------------------------------------
#
# `.do/README.md` has the table of what each one gates and what fails without it. The pattern is the same
# for all of them: absent is refused BY NAME at the point of use, never defaulted, so a missing secret is
# a named error in a log rather than a feature that quietly does nothing.

# The CMS admin and its REST API. The application rejects a known placeholder value outright, because a
# secret everybody can read is not one. Without it the public site serves and the admin refuses by name.
# Left EMPTY rather than filled with a plausible-looking value: a 32-character placeholder reads as a
# real secret to `pnpm secrets`, and a committed example that trips the credential scanner trains people
# to ignore it. Generate it on the droplet with `openssl rand -hex 32` and paste it here.
PAYLOAD_SECRET=

# Signed private-document links. Without it no document is served, rather than one served unsigned.
DOCUMENT_URL_SIGNING_SECRET=
DOCUMENT_URL_SIGNING_SECRET_VERSION=1

# Encrypts Google refresh tokens at rest. Without it the consent callback refuses by name. Only needed
# when GOOGLE_PROVIDER is real, which it is not in this build (ADR 0005).
GOOGLE_TOKEN_KEK=
GOOGLE_TOKEN_KEK_VERSION=1

# Verifies a card gateway's webhook deliveries. Without it the endpoint answers 503
# `[payment-webhook-not-configured]` and writes no row — which is the right failure: a webhook accepted
# without a signature is money moved on an unverified instruction.
PAYMENT_WEBHOOK_SIGNING_SECRET=

# --- host-side knobs --------------------------------------------------------------------------------
#
# The loopback port the reverse proxy forwards to. Change it only if something else on the droplet has
# 3000; `ss -ltnp` tells you.
WEB_PORT=3000

# Hard ceilings, and the reason they are here rather than in the compose file is that they depend on the
# box. These defaults assume a 4 GB droplet already running another site: together they leave roughly
# 1.5 GB for the host and whatever else it serves. Raise them only after `free -m` under load says there
# is room. A container killed at its limit is a clear failure; a droplet out of memory is the kernel
# choosing a victim, and it may choose the live site.
WEB_MEMORY_LIMIT=1536M
WORKER_MEMORY_LIMIT=1024M

LOG_LEVEL=info
