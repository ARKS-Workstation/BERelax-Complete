# Copy to .env.local for development. Never commit a real .env file.
#
# Every key here is validated at boot by @berelax/config. A missing or invalid value stops the
# process with all problems reported at once — it never degrades quietly.

# development | test | preview | staging | production
APP_ENV=development

# PostgreSQL 16. Integration tests require TEST_DATABASE_URL and fail loudly without it.
DATABASE_URL=postgres://berelax:berelax@127.0.0.1:5432/berelax_dev
TEST_DATABASE_URL=postgres://berelax:berelax@127.0.0.1:5432/berelax_test

# Asia/Dubai has no DST, but nothing in the code may assume a fixed offset.
BUSINESS_TIMEZONE=Asia/Dubai

# fake | real — REFUSED as `real` unless APP_ENV=production.
# This is structural, not a preference: it stops a test run messaging real clients, and stops
# non-production burning real Google refresh tokens against the ~100-per-account limit
# (docs/10-google-connection.md §4).
SMS_PROVIDER=fake
EMAIL_PROVIDER=fake
GOOGLE_PROVIDER=fake
PAYMENT_PROVIDER=fake
LLM_PROVIDER=fake

# Recipients a NON-PRODUCTION environment may actually reach, so you can test against your own
# handset. Everything else is diverted to the local outbox and remains inspectable.
# Must be empty in production, where it would silently restrict delivery.
OUTBOUND_ALLOWLIST=

# Required only when GOOGLE_PROVIDER=real. Use a SEPARATE OAuth client per environment:
# re-consenting repeatedly against the production client id silently invalidates the oldest
# refresh tokens.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Signs Payload admin session tokens and password-reset links. Required when APP_ENV=production —
# the process refuses to serve without it (apps/web/payload.config.ts). Deliberately NOT required at
# build time: `next build` loads the CMS config to collect route metadata, and making the signing key
# a build dependency would mean no image could be built without it.
PAYLOAD_SECRET=

# The origin every canonical URL and hreflang alternate is built from (apps/web/src/routes/alternates.ts).
# Read at render time, and therefore at BUILD time for the statically rendered routes — so a preview or
# staging deployment has to set it before `next build`. A preview that announced the production origin as
# canonical would ask Google to index production copies of unreviewed pages. Unset falls back to the live
# domain, which is the relaunch target (docs/13 §5).
SITE_ORIGIN=https://berelaxmassage.com

SENTRY_DSN=
LOG_LEVEL=info
