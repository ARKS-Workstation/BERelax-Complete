{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@berelax/auth": ["./packages/auth/src/index.ts"],
      "@berelax/clinical": ["./packages/clinical/src/index.ts"],
      "@berelax/cms": ["./packages/cms/src/index.ts"],
      "@berelax/config": ["./packages/config/src/index.ts"],
      "@berelax/core": ["./packages/core/src/index.ts"],
      "@berelax/db": ["./packages/db/src/index.ts"],
      "@berelax/fixtures": ["./packages/fixtures/src/index.ts"],
      "@berelax/google": ["./packages/google/src/index.ts"],
      "@berelax/harness": ["./packages/harness/src/index.ts"],
      "@berelax/hr": ["./packages/hr/src/index.ts"],
      "@berelax/media": ["./packages/media/src/index.ts"],
      "@berelax/messaging": ["./packages/messaging/src/index.ts"],
      "@berelax/pdf": ["./packages/pdf/src/index.ts"],
      "@berelax/providers": ["./packages/providers/src/index.ts"],
      "@berelax/shared": ["./packages/shared/src/index.ts"],
      "@berelax/ui": ["./packages/ui/src/index.ts"],
      "@berelax/worker": ["./apps/worker/src/index.ts"],
      "@berelax/auth/*": ["./packages/auth/src/*"],
      "@berelax/clinical/*": ["./packages/clinical/src/*"],
      "@berelax/config/*": ["./packages/config/src/*"],
      "@berelax/core/*": ["./packages/core/src/*"],
      "@berelax/db/*": ["./packages/db/src/*"],
      "@berelax/fixtures/*": ["./packages/fixtures/src/*"],
      "@berelax/google/*": ["./packages/google/src/*"],
      "@berelax/harness/*": ["./packages/harness/src/*"],
      "@berelax/harness/accessibility": ["./packages/harness/src/accessibility.ts"],
      "@berelax/harness/touch-targets": ["./packages/harness/src/touch-targets.ts"],
      "@berelax/hr/*": ["./packages/hr/src/*"],
      "@berelax/media/*": ["./packages/media/src/*"],
      "@berelax/messaging/*": ["./packages/messaging/src/*"],
      "@berelax/pdf/*": ["./packages/pdf/src/*"],
      "@berelax/providers/*": ["./packages/providers/src/*"],
      "@berelax/providers/call-log": ["./packages/providers/src/call-log.ts"],
      "@berelax/providers/failure": ["./packages/providers/src/failure.ts"],
      "@berelax/providers/google": ["./packages/providers/src/google/index.ts"],
      "@berelax/shared/*": ["./packages/shared/src/*"],
      "@berelax/ui/*": ["./packages/ui/src/*"],
      "@berelax/ui/direction": ["./packages/ui/src/primitives/direction.tsx"],
      "@berelax/ui/layout": ["./packages/ui/src/layout/index.tsx"],
      "@berelax/ui/media": ["./packages/ui/src/media/index.ts"],
      "@berelax/ui/media/attach-video-island": ["./packages/ui/src/media/attach-video.island.tsx"],
      "@berelax/ui/media/pause-control": ["./packages/ui/src/media/pause-control.tsx"],
      "@berelax/ui/motion/header-condense": ["./packages/ui/src/motion/header-condense.tsx"],
      "@berelax/ui/motion/reveal": ["./packages/ui/src/motion/reveal.tsx"],
      "@berelax/ui/patterns": ["./packages/ui/src/patterns/index.tsx"],
      "@berelax/ui/primitives": ["./packages/ui/src/primitives/index.tsx"],
      "@berelax/ui/theme-provider": ["./packages/ui/src/theme/theme-provider.tsx"],
      "@berelax/worker/*": ["./apps/worker/src/*"],
      "@berelax/ui/primitives/contract": ["./packages/ui/src/primitives/contract.ts"]
    },
    "types": ["node"]
  }
}
