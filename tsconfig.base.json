{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@berelax/shared": ["./packages/shared/src/index.ts"],
      "@berelax/shared/*": ["./packages/shared/src/*"],
      "@berelax/core": ["./packages/core/src/index.ts"],
      "@berelax/core/*": ["./packages/core/src/*"],
      "@berelax/db": ["./packages/db/src/index.ts"],
      "@berelax/db/*": ["./packages/db/src/*"],
      "@berelax/config": ["./packages/config/src/index.ts"],
      "@berelax/config/*": ["./packages/config/src/*"],
      "@berelax/messaging": ["./packages/messaging/src/index.ts"],
      "@berelax/messaging/*": ["./packages/messaging/src/*"],
      "@berelax/auth": ["./packages/auth/src/index.ts"],
      "@berelax/auth/*": ["./packages/auth/src/*"],
      "@berelax/clinical": ["./packages/clinical/src/index.ts"],
      "@berelax/clinical/*": ["./packages/clinical/src/*"],
      "@berelax/google": ["./packages/google/src/index.ts"],
      "@berelax/google/*": ["./packages/google/src/*"],
      "@berelax/pdf": ["./packages/pdf/src/index.ts"],
      "@berelax/pdf/*": ["./packages/pdf/src/*"],
      "@berelax/ui": ["./packages/ui/src/index.ts"],
      "@berelax/ui/theme-provider": ["./packages/ui/src/theme/theme-provider.tsx"],
      "@berelax/ui/*": ["./packages/ui/src/*"],
      "@berelax/worker": ["./apps/worker/src/index.ts"],
      "@berelax/worker/*": ["./apps/worker/src/*"],
      "@berelax/providers": ["./packages/providers/src/index.ts"],
      "@berelax/providers/google": ["./packages/providers/src/google/index.ts"],
      "@berelax/providers/failure": ["./packages/providers/src/failure.ts"],
      "@berelax/providers/call-log": ["./packages/providers/src/call-log.ts"],
      "@berelax/providers/*": ["./packages/providers/src/*"],
      "@berelax/fixtures": ["./packages/fixtures/src/index.ts"],
      "@berelax/fixtures/*": ["./packages/fixtures/src/*"],
      "@berelax/harness": ["./packages/harness/src/index.ts"],
      "@berelax/harness/*": ["./packages/harness/src/*"]
    },
    "types": ["node"]
  }
}
