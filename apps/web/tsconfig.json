{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "types": ["node", "react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@berelax/shared": ["../../packages/shared/src/index.ts"],
      "@berelax/core": ["../../packages/core/src/index.ts"],
      "@berelax/config": ["../../packages/config/src/index.ts"],
      "@berelax/db": ["../../packages/db/src/index.ts"],
      "@berelax/fixtures": ["../../packages/fixtures/src/index.ts"],
      "@berelax/messaging": ["../../packages/messaging/src/index.ts"],
      "@berelax/messaging/transports/smsala": ["../../packages/messaging/src/transports/smsala.ts"],
      "@berelax/providers": ["../../packages/providers/src/index.ts"],
      "@berelax/ui": ["../../packages/ui/src/index.ts"],
      "@berelax/ui/theme-provider": ["../../packages/ui/src/theme/theme-provider.tsx"],
      "@berelax/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
