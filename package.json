{
  "name": "berelax",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "boundaries:test": "node scripts/test-boundaries.mjs",
    "palette": "python3 scripts/palette.py",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm boundaries:test && pnpm palette && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "dependency-cruiser": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
