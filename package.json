{
  "name": "berelax",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "boundaries:test": "node scripts/test-boundaries.mjs",
    "palette": "python3 scripts/palette.py",
    "test": "vitest run -c vitest.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm boundaries:test && pnpm purity && pnpm palette && pnpm test && pnpm test:integration && pnpm db:migrate:dry && pnpm db:drift && pnpm gates:test",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate:dry": "node scripts/migrate-dry-run.mjs",
    "gates:test": "node scripts/test-gates.mjs",
    "purity": "node scripts/check-core-purity.mjs",
    "db:drift": "node scripts/check-schema-drift.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.1",
    "dependency-cruiser": "18.3.1",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.33.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  }
}
