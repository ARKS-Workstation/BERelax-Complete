{
  "name": "berelax",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "a11y": "tsx scripts/accessibility.mjs",
    "adr": "node scripts/check-adr-coverage.mjs",
    "alerts": "tsx scripts/check-alert-registry.mjs",
    "audit:online": "pnpm audit --audit-level high",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "boundaries:test": "node scripts/test-boundaries.mjs",
    "budgets": "tsx scripts/check-budgets.mjs",
    "chokepoint": "node scripts/check-google-token-chokepoint.mjs",
    "cms": "node scripts/check-cms-boundary.mjs",
    "colours": "node scripts/check-colour-tokens.mjs",
    "container": "node scripts/check-container.mjs",
    "coverage": "vitest run -c vitest.config.ts --coverage.enabled",
    "critique": "tsx scripts/screenshots.mjs --critique-only",
    "db:apply": "node scripts/apply-migrations.mjs",
    "db:conventions": "node scripts/check-schema-conventions.mjs",
    "db:drift": "node scripts/check-schema-drift.mjs",
    "db:migrate:dry": "node scripts/migrate-dry-run.mjs",
    "dry-runs": "tsx scripts/check-dry-runs.mjs",
    "descriptor-lint": "tsx scripts/check-descriptor-lint.mjs",
    "deps": "node scripts/check-dependencies.mjs",
    "docs-set": "node scripts/gen-adr-index.mjs && node scripts/gen-secret-inventory.mjs && node scripts/check-docs-links.mjs",
    "docs:adr": "node scripts/gen-adr-index.mjs --emit",
    "docs:secrets": "node scripts/gen-secret-inventory.mjs --emit",
    "documents": "node scripts/check-tax-documents.mjs",
    "egress": "node scripts/check-egress-guard.mjs",
    "event-attributes": "tsx scripts/check-event-attributes.mjs",
    "fixtures": "tsx scripts/fixture-digest.mjs",
    "fonts": "node scripts/emit-font-metrics.mjs",
    "fonts:emit": "node scripts/emit-font-metrics.mjs --emit",
    "fixtures:emit": "tsx scripts/fixture-digest.mjs --emit",
    "go-live:payments": "tsx scripts/go-live-payments.mjs",
    "gate-registry": "node scripts/check-gate-registry.mjs",
    "gates:test": "node scripts/test-gates.mjs",
    "gates:only": "node scripts/gate-slice.mjs",
    "verify:except-gates": "node scripts/verify-except-gates.mjs",
    "invisibles": "node scripts/check-invisible-chars.mjs",
    "jobs": "tsx scripts/check-job-registry.mjs",
    "layout": "node scripts/check-layout-rules.mjs",
    "licences": "node scripts/check-licences.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "media": "node scripts/check-media.mjs",
    "money-invariants": "tsx scripts/money-invariants.mjs",
    "offline-money": "node scripts/check-offline-money.mjs",
    "headers": "node scripts/check-headers.mjs",
    "no-autofile": "node scripts/test-no-autofile.mjs",
    "no-invoice-mutation": "node scripts/test-no-invoice-mutation.mjs",
    "media:emit": "node scripts/emit-media-manifest.mjs",
    "palette": "python3 scripts/palette.py",
    "palette:emit": "python3 scripts/palette.py --emit",
    "pdf:fixtures": "tsx scripts/render-pdf-fixtures.mjs",
    "perf-layers": "node scripts/check-performance-layers.mjs",
    "pii": "node scripts/check-staff-pii.mjs",
    "private-documents": "node scripts/check-private-documents.mjs",
    "processors": "tsx scripts/check-processor-register.mjs",
    "progress": "python3 scripts/progress.py",
    "progress:check": "python3 scripts/progress.py --check",
    "purity": "node scripts/check-core-purity.mjs",
    "rotate:kek": "tsx scripts/rotate-kek.mjs",
    "rotation": "node scripts/check-secret-rotation.mjs",
    "saq-a": "node scripts/check-saq-a.mjs",
    "screens": "tsx scripts/screenshots.mjs",
    "secrets": "node scripts/check-secrets.mjs",
    "send-chokepoint": "node scripts/check-send-chokepoint.mjs",
    "structured-data": "tsx scripts/validate-structured-data.mjs",
    "seed": "tsx scripts/seed.mjs",
    "sqlstate": "tsx scripts/check-sqlstate-registry.mjs",
    "touch-targets": "tsx scripts/check-touch-targets.mjs",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "tokens": "tsx scripts/emit-tokens.mjs",
    "tokens:emit": "tsx scripts/emit-tokens.mjs --emit",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm boundaries:test && pnpm purity && pnpm invisibles && pnpm secrets && pnpm rotation && pnpm pii && pnpm deps && pnpm licences && pnpm container && pnpm palette && pnpm tokens && pnpm colours && pnpm cms && pnpm documents && pnpm no-invoice-mutation && pnpm no-autofile && pnpm structured-data && pnpm redirects && pnpm chokepoint && pnpm send-chokepoint && pnpm private-documents && pnpm saq-a && pnpm egress && pnpm event-attributes && pnpm layout && pnpm jobs && pnpm alerts && pnpm processors && pnpm adr && pnpm docs-set && pnpm progress:check && pnpm media && pnpm fixtures && pnpm fonts && pnpm critique && pnpm a11y && pnpm touch-targets && pnpm coverage && pnpm test:integration && pnpm money-invariants && pnpm db:migrate:dry && pnpm db:drift && pnpm db:conventions && pnpm sqlstate && pnpm dry-runs && pnpm budgets && pnpm gate-registry && pnpm gates:test && pnpm descriptor-lint && pnpm perf-layers && pnpm offline-money && pnpm headers",
    "redirects": "tsx scripts/check-redirect-coverage.mjs",
    "redirects:import": "tsx scripts/import-crawl-baseline.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.10.1",
    "playwright": "1.56.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.33.1",
    "postgres": "3.4.9",
    "sharp": "^0.35.4",
    "zod": "4.6.5"
  }
}
